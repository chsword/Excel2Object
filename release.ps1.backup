#!/usr/bin/env pwsh
<#
.SYNOPSIS
    鑷姩鍖栧彂甯冭剼鏈?- 鏇存柊鐗堟湰鍙枫€佹彁浜や唬鐮併€佸垱寤哄苟鎺ㄩ€乀ag
    Release automation script - Update version, commit changes, create and push tag

.DESCRIPTION
    璇ヨ剼鏈嚜鍔ㄦ墽琛屼互涓嬫搷浣滐細
    1. 鏇存柊 Chsword.Excel2Object.csproj 涓殑鐗堟湰鍙?
    2. 鎻愪氦浠ｇ爜鍒?Git 浠撳簱
    3. 鍒涘缓 Git Tag (鏍煎紡: v{version})
    4. 鎺ㄩ€佷唬鐮佸拰 Tag 鍒拌繙绋嬩粨搴?

    This script automates the following operations:
    1. Update version in Chsword.Excel2Object.csproj
    2. Commit changes to Git repository
    3. Create Git Tag (format: v{version})
    4. Push code and tag to remote repository

.PARAMETER Version
    鏂扮増鏈彿锛屾牸寮忥細涓荤増鏈?娆＄増鏈?淇鐗?(渚嬪: 2.0.3)
    New version number, format: Major.Minor.Patch (e.g., 2.0.3)

.PARAMETER SkipPush
    浠呭垱寤烘湰鍦版彁浜ゅ拰鏍囩锛屼笉鎺ㄩ€佸埌杩滅▼浠撳簱
    Only create local commits and tags, do not push to remote

.PARAMETER Force
    寮哄埗鎵ц锛岃烦杩囩‘璁ゆ彁绀?
    Force execution, skip confirmation prompts

.EXAMPLE
    ./release.ps1 -Version 2.0.3
    鏇存柊鐗堟湰鍒?2.0.3锛屾彁浜ゅ苟鎺ㄩ€?

.EXAMPLE
    ./release.ps1 -Version 2.1.0 -SkipPush
    鏇存柊鐗堟湰鍒?2.1.0锛屼粎鏈湴鎻愪氦锛屼笉鎺ㄩ€?

.EXAMPLE
    ./release.ps1 -Version 3.0.0 -Force
    寮哄埗鏇存柊鐗堟湰鍒?3.0.0锛岃烦杩囩‘璁ゆ彁绀?
#>

param(
    [Parameter(Mandatory = $true, HelpMessage = "鐗堟湰鍙?(渚嬪: 2.0.3)")]
    [string]$Version,
    
    [Parameter(Mandatory = $false)]
    [switch]$SkipPush,
    
    [Parameter(Mandatory = $false)]
    [switch]$Force
)

# 璁剧疆閿欒澶勭悊
$ErrorActionPreference = "Stop"

# 棰滆壊杈撳嚭鍑芥暟
function Write-ColorOutput {
    param(
        [string]$Message,
        [string]$Color = "White"
    )
    Write-Host $Message -ForegroundColor $Color
}

function Write-Success {
    param([string]$Message)
    Write-ColorOutput "鉁?$Message" "Green"
}

function Write-Error {
    param([string]$Message)
    Write-ColorOutput "鉁?$Message" "Red"
}

function Write-Info {
    param([string]$Message)
    Write-ColorOutput "鈩?$Message" "Cyan"
}

function Write-Warning {
    param([string]$Message)
    Write-ColorOutput "鈿?$Message" "Yellow"
}

# 楠岃瘉鐗堟湰鍙锋牸寮?(璇箟鍖栫増鏈?
function Test-VersionFormat {
    param([string]$Ver)
    
    if ($Ver -match '^\d+\.\d+\.\d+$') {
        return $true
    }
    return $false
}

# 鎻愬彇褰撳墠鐗堟湰鍙?
function Get-CurrentVersion {
    $csprojPath = "Chsword.Excel2Object/Chsword.Excel2Object.csproj"
    
    if (-not (Test-Path $csprojPath)) {
        throw "鎵句笉鍒伴」鐩枃浠? $csprojPath"
    }
    
    $content = Get-Content $csprojPath -Raw
    if ($content -match '<Version>([^<]+)</Version>') {
        return $Matches[1]
    }
    
    throw "鏃犳硶浠庨」鐩枃浠朵腑鎻愬彇鐗堟湰鍙?
}

# 鏇存柊鐗堟湰鍙?
function Update-Version {
    param(
        [string]$NewVersion
    )
    
    $csprojPath = "Chsword.Excel2Object/Chsword.Excel2Object.csproj"
    
    $content = Get-Content $csprojPath -Raw
    $newContent = $content -replace '<Version>[^<]+</Version>', "<Version>$NewVersion</Version>"
    
    Set-Content -Path $csprojPath -Value $newContent -NoNewline
    
    Write-Success "鐗堟湰鍙峰凡鏇存柊涓? $NewVersion"
}

# 妫€鏌?Git 鐘舵€?
function Test-GitClean {
    $status = git status --porcelain
    if ($status) {
        return $false
    }
    return $true
}

# 妫€鏌ユ槸鍚﹀湪 Git 浠撳簱涓?
function Test-GitRepository {
    try {
        git rev-parse --git-dir 2>&1 | Out-Null
        return $LASTEXITCODE -eq 0
    }
    catch {
        return $false
    }
}

# 妫€鏌?Tag 鏄惁宸插瓨鍦?
function Test-TagExists {
    param([string]$TagName)
    
    $tags = git tag -l $TagName
    return ($tags -eq $TagName)
}

# 涓绘祦绋?
try {
    Write-Info "===== Excel2Object 鑷姩鍖栧彂甯冭剼鏈?====="
    Write-Info ""
    
    # 楠岃瘉鐗堟湰鍙锋牸寮?
    if (-not (Test-VersionFormat -Ver $Version)) {
        Write-Error "鐗堟湰鍙锋牸寮忛敊璇紒璇蜂娇鐢ㄨ涔夊寲鐗堟湰鏍煎紡 (渚嬪: 2.0.3)"
        exit 1
    }
    
    # 妫€鏌ユ槸鍚﹀湪 Git 浠撳簱涓?
    if (-not (Test-GitRepository)) {
        Write-Error "褰撳墠鐩綍涓嶆槸 Git 浠撳簱锛?
        exit 1
    }
    
    # 鑾峰彇褰撳墠鐗堟湰
    $currentVersion = Get-CurrentVersion
    Write-Info "褰撳墠鐗堟湰: $currentVersion"
    Write-Info "鐩爣鐗堟湰: $Version"
    Write-Info ""
    
    # 妫€鏌ョ増鏈槸鍚︾浉鍚?
    if ($currentVersion -eq $Version) {
        Write-Warning "鐩爣鐗堟湰涓庡綋鍓嶇増鏈浉鍚岋紝鏃犻渶鏇存柊銆?
        if (-not $Force) {
            $continue = Read-Host "鏄惁缁х画锛?y/N)"
            if ($continue -ne 'y' -and $continue -ne 'Y') {
                Write-Info "鎿嶄綔宸插彇娑堛€?
                exit 0
            }
        }
    }
    
    # 妫€鏌ュ伐浣滅洰褰曟槸鍚﹀共鍑€
    if (-not (Test-GitClean)) {
        Write-Warning "宸ヤ綔鐩綍鏈夋湭鎻愪氦鐨勬洿鏀癸紒"
        git status --short
        Write-Info ""
        
        if (-not $Force) {
            $continue = Read-Host "鏄惁缁х画锛熻繖灏嗘彁浜ゆ墍鏈夋洿鏀?(y/N)"
            if ($continue -ne 'y' -and $continue -ne 'Y') {
                Write-Info "鎿嶄綔宸插彇娑堛€?
                exit 0
            }
        }
    }
    
    # 妫€鏌?Tag 鏄惁宸插瓨鍦?
    $tagName = "v$Version"
    if (Test-TagExists -TagName $tagName) {
        Write-Error "Tag '$tagName' 宸插瓨鍦紒"
        Write-Info "璇蜂娇鐢ㄤ笉鍚岀殑鐗堟湰鍙锋垨鍒犻櫎鐜版湁 Tag锛?
        Write-Info "  git tag -d $tagName"
        Write-Info "  git push origin :refs/tags/$tagName"
        exit 1
    }
    
    # 纭鎿嶄綔
    if (-not $Force) {
        Write-Info ""
        Write-Warning "鍗冲皢鎵ц浠ヤ笅鎿嶄綔锛?
        Write-Info "  1. 鏇存柊鐗堟湰鍙? $currentVersion 鈫?$Version"
        Write-Info "  2. 鎻愪氦鏇存敼: 'chore: bump version to $Version'"
        Write-Info "  3. 鍒涘缓 Tag: $tagName"
        if (-not $SkipPush) {
            Write-Info "  4. 鎺ㄩ€佸埌杩滅▼浠撳簱"
        }
        Write-Info ""
        
        $confirm = Read-Host "纭鎵ц锛?y/N)"
        if ($confirm -ne 'y' -and $confirm -ne 'Y') {
            Write-Info "鎿嶄綔宸插彇娑堛€?
            exit 0
        }
        Write-Info ""
    }
    
    # 姝ラ 1: 鏇存柊鐗堟湰鍙?
    Write-Info "姝ラ 1/4: 鏇存柊鐗堟湰鍙?.."
    Update-Version -NewVersion $Version
    
    # 姝ラ 2: 鎻愪氦鏇存敼
    Write-Info "姝ラ 2/4: 鎻愪氦鏇存敼..."
    git add .
    git commit -m "chore: bump version to $Version"
    Write-Success "浠ｇ爜宸叉彁浜?
    
    # 姝ラ 3: 鍒涘缓 Tag
    Write-Info "姝ラ 3/4: 鍒涘缓 Tag..."
    git tag $tagName
    Write-Success "Tag '$tagName' 宸插垱寤?
    
    # 姝ラ 4: 鎺ㄩ€佸埌杩滅▼
    if (-not $SkipPush) {
        Write-Info "姝ラ 4/4: 鎺ㄩ€佸埌杩滅▼浠撳簱..."
        
        # 鑾峰彇褰撳墠鍒嗘敮
        $currentBranch = git rev-parse --abbrev-ref HEAD
        
        # 鎺ㄩ€佷唬鐮?
        Write-Info "鎺ㄩ€佸垎鏀?'$currentBranch'..."
        git push origin $currentBranch
        Write-Success "浠ｇ爜宸叉帹閫佸埌 origin/$currentBranch"
        
        # 鎺ㄩ€?Tag
        Write-Info "鎺ㄩ€?Tag '$tagName'..."
        git push origin $tagName
        Write-Success "Tag 宸叉帹閫?
    }
    else {
        Write-Info "姝ラ 4/4: 璺宠繃鎺ㄩ€?(浣跨敤浜?-SkipPush 鍙傛暟)"
        Write-Warning "璇锋墜鍔ㄦ帹閫佷唬鐮佸拰 Tag锛?
        Write-Info "  git push origin $(git rev-parse --abbrev-ref HEAD)"
        Write-Info "  git push origin $tagName"
    }
    
    # 瀹屾垚
    Write-Info ""
    Write-Success "===== 鍙戝竷娴佺▼瀹屾垚 ====="
    Write-Info ""
    Write-Info "鐗堟湰 $Version 宸插噯澶囧氨缁紒"
    
    if (-not $SkipPush) {
        Write-Info ""
        Write-Info "GitHub Actions 灏嗚嚜鍔ㄥ紑濮嬫瀯寤哄拰鍙戝竷娴佺▼锛?
        Write-Info "  鈫?https://github.com/chsword/Excel2Object/actions"
        Write-Info ""
        Write-Info "棰勮 5-10 鍒嗛挓鍚庡彲鍦ㄤ互涓嬩綅缃煡鐪嬪彂甯冪粨鏋滐細"
        Write-Info "  鈫?NuGet: https://www.nuget.org/packages/Chsword.Excel2Object"
        Write-Info "  鈫?GitHub: https://github.com/chsword/Excel2Object/releases"
    }
}
catch {
    Write-Error "鍙戠敓閿欒: $_"
    Write-Info ""
    Write-Info "濡傞渶甯姪锛岃鏌ョ湅鏂囨。锛?
    Write-Info "  鈫?RELEASE_AUTOMATION.md"
    exit 1
}
