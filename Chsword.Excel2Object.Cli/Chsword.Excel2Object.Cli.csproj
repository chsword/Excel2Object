<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- One TFM only: NPOI drags SkiaSharp natives for every RID into the tool package, and NuGet caps packages at 250 MB. -->
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <AssemblyName>excel2obj</AssemblyName>
    <RootNamespace>Chsword.Excel2Object.Cli</RootNamespace>

    <!-- Installed with: dotnet tool install -g Chsword.Excel2Object.Cli -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>excel2obj</ToolCommandName>
    <PackageId>Chsword.Excel2Object.Cli</PackageId>
    <!-- Same version as the library, read from its project file so release.ps1 only bumps one place -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../Chsword.Excel2Object/Chsword.Excel2Object.csproj')), '&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;').Groups[1].Value)</Version>
    <Authors>Zou Jian</Authors>
    <Description>Command-line tool for Excel2Object: convert Excel to JSON and back, and generate C# model classes from a sheet.</Description>
    <PackageProjectUrl>https://github.com/chsword/Excel2Object/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/chsword/Excel2Object</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>excel;json;cli;dotnet-tool;codegen</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chsword.Excel2Object\Chsword.Excel2Object.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- SkiaSharp's Windows native symbols alone are ~240 MB; the tool does not need any debug symbols. -->
  <Target Name="DropNativeSymbolsFromToolPackage" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_NativeSymbol Include="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
      <ResolvedFileToPublish Remove="@(_NativeSymbol)" />
    </ItemGroup>
  </Target>

</Project>
