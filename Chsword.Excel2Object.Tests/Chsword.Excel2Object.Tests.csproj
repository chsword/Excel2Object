<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 库发布 7 个目标框架，此处按「能跑起来的运行时」取样：net10.0 与 net8.0 覆盖 .NET，
         net472 覆盖 .NET Framework（仅 Windows 可运行，故按平台条件加入）。
         netstandard2.0 / 2.1 不是可运行的目标框架，其产物由编译保证，无法在此直接运行。 -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net472;net8.0;net10.0</TargetFrameworks>
	  <Nullable>annotations</Nullable>
    <!-- 与库一致，各目标框架使用同一语言版本：否则 net8.0 会退回 C# 12，
         表达式树中省略可选参数的调用将编译失败（CS0854） -->
    <LangVersion>14.0</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>TRACE;DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.9.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.9.3" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- 流式导出走 NPOI 的 SXSSF，后者把行刷出内存时要用 SkiaSharp 量字符宽度。NPOI 把 SkiaSharp
         标为不随包传递的依赖，故此处与使用方一样自行引用；Linux 上的本机库另需 NativeAssets 包，
         Windows 与 macOS 的由 SkiaSharp 自带。 -->
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chsword.Excel2Object\Chsword.Excel2Object.csproj" />
  </ItemGroup>

  <!-- 命令行工具只发布 net8.0，.NET Framework 无法引用，故该目标框架下不含其测试 -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net472'">
    <ProjectReference Include="..\Chsword.Excel2Object.Cli\Chsword.Excel2Object.Cli.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Compile Remove="CliTest.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="ExcelDir\test.person.special-char.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ExcelDir\test-issue32-skipline.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ExcelDir\test-pr28-multiples-heet.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ExcelDir\test.person.unnullable.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="ExcelDir\test.person.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>